<?xml version='1.0' encoding='utf-8'?>
<routes>
    <!-- Vehicle types and static routes. Demand is kept in demand.rou.xml. -->
    <!-- Route IDs follow <origin>_to_<destination>, e.g. E_to_W means enter from east and leave west. -->
    <!-- Straight: N_to_S, S_to_N, E_to_W, W_to_E. Left: N_to_E, S_to_W, E_to_S, W_to_N. Right: N_to_W, S_to_E, E_to_N, W_to_S. -->
    <vType id="passenger" vClass="passenger" accel="2.6" decel="4.5" sigma="0.5" length="5.0" minGap="2.5" maxSpeed="13.89" />
    <vType id="delivery" vClass="delivery" accel="2.0" decel="4.0" sigma="0.5" length="7.0" minGap="3.0" maxSpeed="12.50" />
    <vType id="truck" vClass="truck" accel="1.3" decel="3.5" sigma="0.5" length="12.0" minGap="3.5" maxSpeed="11.11" />
    <route id="N_to_S" edges="N_in S_out" description="straight" />
    <route id="N_to_E" edges="N_in E_out" description="left" />
    <route id="N_to_W" edges="N_in W_out" description="right" />
    <route id="S_to_N" edges="S_in N_out" description="straight" />
    <route id="S_to_W" edges="S_in W_out" description="left" />
    <route id="S_to_E" edges="S_in E_out" description="right" />
    <route id="E_to_W" edges="E_in W_out" description="straight" />
    <route id="E_to_S" edges="E_in S_out" description="left" />
    <route id="E_to_N" edges="E_in N_out" description="right" />
    <route id="W_to_E" edges="W_in E_out" description="straight" />
    <route id="W_to_N" edges="W_in N_out" description="left" />
    <route id="W_to_S" edges="W_in S_out" description="right" />
</routes>